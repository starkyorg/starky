{
  "name": "starky",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "nodemon server.ts",
    "dev:https": "cross-env DEV_HTTPS_ENABLED=true BASE_URL=https://localhost:8443 DOMAIN=https://localhost:8443 PORT=8443 nodemon server.ts",
    "build:next": "next build",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "cross-env NODE_ENV=production pnpm build:next && cross-env NODE_ENV=production pnpm build:server",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "postinstall": "husky install",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@apibara/protocol": "^2.0.0-beta.42",
    "@apibara/starknet": "^2.0.0-beta.42",
    "@cartridge/controller": "^0.13.10",
    "@discordjs/rest": "^2.6.0",
    "@grpc/grpc-js": "^1.14.3",
    "@tanstack/react-query": "^5.90.21",
    "@walletconnect/web3-provider": "^1.8.0",
    "axios": "^1.13.6",
    "bn.js": "^5.2.3",
    "chart.js": "^4.5.1",
    "cross-env": "^7.0.3",
    "discord-api-types": "^0.38.40",
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "ethers": "^6.16.0",
    "lucide-react": "^0.576.0",
    "nanoid": "^3.3.11",
    "next": "^14.2.35",
    "pg": "^8.19.0",
    "react": "18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.2.2",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "starknet": "^5.29.0",
    "starknetkit": "^1.1.9",
    "ts-parse-database-url": "^1.0.3",
    "typeorm": "^0.3.28",
    "viem": "^2.46.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.18.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/uuid": "^10.0.0",
    "eslint": "8.57.1",
    "eslint-config-next": "12.3.7",
    "eslint-config-prettier": "^8.10.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^13.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{tsx,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
